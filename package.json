{
  "name": "@tukuyomil032/stela",
  "private": false,
  "version": "0.0.3",
  "description": "A TypeScript-based CLI that lets you view a list of repositories you've starred, unstar them, and search for repositories using a wide range of criteria—such as language, genre, and keyword matches—to find new ones to star.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "stela": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "husky || true",
    "prepublishOnly": "bun run build",
    "dev": "ts-node --esm src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint-staged": "lint-staged",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\""
  },
  "keywords": [
    "cli",
    "github",
    "starred-repositories",
    "typescript",
    "nodejs",
    "open-source",
    "command-line-tool",
    "repository-management",
    "developer-tools"
  ],
  "author": "tukuyomil032",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tukuyomil032/stela.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/tukuyomil032/stela/issues"
  },
  "homepage": "https://github.com/tukuyomil032/stela#readme",
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "gradient-string": "^3.0.0",
    "marked": "^12",
    "marked-terminal": "^7.3.0",
    "oh-my-logo": "^0.4.0",
    "ora": "^9.4.0",
    "string-width": "^8.2.1",
    "terminal-image": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/cli-progress": "^3.11.6",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write"
    ]
  },
  "packageManager": "bun@1.3.13"
}
